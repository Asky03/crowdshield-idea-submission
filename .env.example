# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/crowdshield
# Or use Supabase: postgresql://user:pass@db.supabase.co:5432/postgres

# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-south-1
S3_BUCKET_NAME=crowdshield-frames
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:crowdshield-alerts

# API Configuration
API_KEY=your_secure_api_key_here
PORT=3000
NODE_ENV=development

# ML Pipeline Configuration
YOLO_MODEL_PATH=./models/yolov8n.pt
FRAME_EXTRACTION_FPS=1
CONFIDENCE_THRESHOLD=0.5

# Alert Thresholds
RISK_THRESHOLD_MEDIUM=0.4
RISK_THRESHOLD_HIGH=0.6
RISK_THRESHOLD_CRITICAL=0.8

# Frontend Configuration (if separate)
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
